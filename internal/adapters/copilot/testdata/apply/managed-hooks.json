{
  "hooks": {
    "preToolUse": [
      {
        "bash": "'/usr/local/bin/cyberboar' 'hook' '--agent' 'copilot-cli' '--policy' '/etc/cyberboar/policy.yaml' '--audit' '/var/log/cyberboar/audit.jsonl' '--pubkey' '/etc/cyberboar/policy.pub' '--deadline' '5s' || exit 2",
        "powershell": "[Console]::Error.WriteLine('cyberboar: GitHub Copilot on native Windows is not supported, so the tool call is blocked; use WSL or a Linux dev container'); exit 2",
        "timeoutSec": 15,
        "type": "command"
      }
    ],
    "sessionStart": [
      {
        "bash": "'/usr/local/bin/cyberboar' 'brief' '--agent' 'copilot-cli' '--policy' '/etc/cyberboar/policy.yaml' '--pubkey' '/etc/cyberboar/policy.pub'",
        "timeoutSec": 15,
        "type": "command"
      }
    ]
  },
  "version": 1
}
