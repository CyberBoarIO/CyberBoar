{
  "notes": [
    "command pattern \"curl | sh\" (pipeline, quoting or ?/[ ] wildcards) has no native equivalent; only the hook enforces it",
    "denyInterpreters: native rules cover only common spellings (sh -c, bash -c, zsh -c and others); the hook covers the rest",
    "allow lists and allow-listed posture are enforced only by the hook (native allow rules would skip permission prompts)",
    "files.containing (directories that contain protected files) is enforced only by the hook",
    "case-insensitive matching, wrappers beyond timeout/time/nice/nohup/stdbuf, and unclassified tools are enforced only by the hook"
  ],
  "settings": {
    "allowManagedHooksOnly": true,
    "disableAllHooks": false,
    "hooks": {
      "PreToolUse": [
        {
          "hooks": [
            {
              "args": [
                "hook",
                "--policy",
                "/etc/cyberboar/policy.yaml",
                "--audit",
                "/var/log/cyberboar/audit.jsonl",
                "--deadline",
                "5s"
              ],
              "command": "/usr/local/bin/cyberboar",
              "onFailure": "block",
              "statusMessage": "cyberboar: checking policy",
              "timeout": 10,
              "type": "command"
            }
          ],
          "matcher": "*"
        }
      ],
      "SessionStart": [
        {
          "hooks": [
            {
              "args": [
                "brief",
                "--policy",
                "/etc/cyberboar/policy.yaml"
              ],
              "command": "/usr/local/bin/cyberboar",
              "statusMessage": "cyberboar: briefing",
              "timeout": 10,
              "type": "command"
            }
          ]
        }
      ]
    },
    "permissions": {
      "ask": [
        "Read(//**/terraform.tfstate)",
        "Edit(//**/terraform.tfstate)",
        "Bash(git push *)",
        "PowerShell(git push *)"
      ],
      "deny": [
        "Read(//**/.env*)",
        "Edit(//**/.env*)",
        "Read(//**/*.pem)",
        "Edit(//**/*.pem)",
        "Read(~/.ssh/**)",
        "Edit(~/.ssh/**)",
        "Read(~/.aws/credentials)",
        "Edit(~/.aws/credentials)",
        "Bash(terraform apply *)",
        "PowerShell(terraform apply *)",
        "Bash(kubectl delete *)",
        "PowerShell(kubectl delete *)",
        "Bash(sh -c *)",
        "PowerShell(sh -c *)",
        "Bash(bash -c *)",
        "PowerShell(bash -c *)",
        "Bash(zsh -c *)",
        "PowerShell(zsh -c *)",
        "Bash(dash -c *)",
        "PowerShell(dash -c *)",
        "Bash(ksh -c *)",
        "PowerShell(ksh -c *)",
        "Bash(eval *)",
        "PowerShell(eval *)",
        "Bash(python -c *)",
        "PowerShell(python -c *)",
        "Bash(python3 -c *)",
        "PowerShell(python3 -c *)",
        "Bash(node -e *)",
        "PowerShell(node -e *)",
        "Bash(node -p *)",
        "PowerShell(node -p *)",
        "Bash(perl -e *)",
        "PowerShell(perl -e *)",
        "Bash(perl -E *)",
        "PowerShell(perl -E *)",
        "Bash(ruby -e *)",
        "PowerShell(ruby -e *)",
        "Bash(php -r *)",
        "PowerShell(php -r *)",
        "Bash(pwsh -c *)",
        "PowerShell(pwsh -c *)",
        "Bash(pwsh -Command *)",
        "PowerShell(pwsh -Command *)",
        "Bash(osascript -e *)",
        "PowerShell(osascript -e *)",
        "PowerShell(Invoke-Expression *)",
        "Edit(//**/.claude/settings.json)",
        "Edit(//**/.claude/settings.local.json)",
        "Edit(//**/.claude/agents/**)",
        "Edit(//**/.claude/skills/**)",
        "Edit(//**/.claude/commands/**)",
        "Edit(//**/.claude/plugins/**)",
        "Edit(~/.profile)",
        "Edit(~/.bash_profile)",
        "Edit(~/.bash_login)",
        "Edit(~/.bashrc)",
        "Edit(~/.bash_logout)",
        "Edit(~/.zshenv)",
        "Edit(~/.zprofile)",
        "Edit(~/.zshrc)",
        "Edit(~/.zlogin)",
        "Edit(~/.zlogout)",
        "Edit(//etc/cyberboar/policy.yaml)",
        "Edit(//etc/cyberboar/policy.yaml.sig)",
        "Edit(//var/log/cyberboar/audit.jsonl)",
        "Edit(//usr/local/bin/cyberboar)"
      ]
    }
  }
}
