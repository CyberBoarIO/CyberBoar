{
  "notes": [
    "denyInterpreters: native rules cover only common spellings (sh -c, bash -c, zsh -c and others); the hook covers the rest",
    "allow lists and allow-listed posture are enforced only by the hook (native allow rules would skip permission prompts)",
    "files.containing (directories that contain protected files) is enforced only by the hook",
    "case-insensitive matching, wrappers beyond timeout/time/nice/nohup/stdbuf, and unclassified tools are enforced only by the hook"
  ],
  "settings": {
    "hooks": {
      "PreToolUse": [
        {
          "hooks": [
            {
              "args": [
                "hook",
                "--policy",
                "${CLAUDE_PROJECT_DIR}/.cyberboar/policy.yaml",
                "--deadline",
                "5s"
              ],
              "command": "cyberboar",
              "onFailure": "block",
              "statusMessage": "cyberboar: checking policy",
              "timeout": 10,
              "type": "command"
            }
          ],
          "matcher": "*"
        }
      ],
      "SessionStart": [
        {
          "hooks": [
            {
              "args": [
                "brief",
                "--policy",
                "${CLAUDE_PROJECT_DIR}/.cyberboar/policy.yaml"
              ],
              "command": "cyberboar",
              "statusMessage": "cyberboar: briefing",
              "timeout": 10,
              "type": "command"
            }
          ]
        }
      ]
    },
    "permissions": {
      "ask": [
        "Bash(git commit *)",
        "Bash(git push *)"
      ],
      "deny": [
        "Read(//**/.env*)",
        "Edit(//**/.env*)",
        "Read(//**/*.pem)",
        "Edit(//**/*.pem)",
        "Read(~/.ssh/**)",
        "Edit(~/.ssh/**)",
        "Bash(sh -c *)",
        "Bash(bash -c *)",
        "Bash(zsh -c *)",
        "Bash(dash -c *)",
        "Bash(ksh -c *)",
        "Bash(eval *)",
        "Bash(python -c *)",
        "Bash(python3 -c *)",
        "Bash(node -e *)",
        "Bash(node -p *)",
        "Bash(perl -e *)",
        "Bash(perl -E *)",
        "Bash(ruby -e *)",
        "Bash(php -r *)",
        "Bash(pwsh -c *)",
        "Bash(pwsh -Command *)",
        "Bash(osascript -e *)",
        "Edit(//**/.claude/settings.json)",
        "Edit(//**/.claude/settings.local.json)",
        "Edit(/.cyberboar/policy.yaml)",
        "Edit(/.cyberboar/policy.yaml.sig)",
        "PowerShell"
      ]
    }
  }
}
